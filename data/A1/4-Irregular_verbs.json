  "definition": {
    "english": "Irregular verbs do not always follow the standard present-tense pattern. Some have special forms that must be memorised; others change their stem vowel mainly in the du and er/sie/es forms.",
    "example": {
      "german": "essen → ich esse, du isst, er isst",
      "english": "to eat → I eat, you eat, he/she/it eats"
    }
  },
  "important_rule": {
    "english": "Many A1 stem-changing verbs change only in the du and er/sie/es forms. The wir, ihr, and sie/Sie forms usually keep the infinitive stem pattern.",
    "examples": [
      {
        "infinitive": "sprechen",
        "forms": "ich spreche; du sprichst; er spricht; wir sprechen; ihr sprecht; sie sprechen"
      },
      {
        "infinitive": "fahren",
        "forms": "ich fahre; du fährst; er fährt; wir fahren; ihr fahrt; sie fahren"
      }
    ]
  },
