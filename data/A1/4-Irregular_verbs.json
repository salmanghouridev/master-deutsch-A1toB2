  "common_mistakes": [
    {
      "incorrect": "Du esst Brot.",
      "correct": "Du isst Brot.",
      "explanation": "For essen, du uses isst; esst is the ihr form."
    },
    {
      "incorrect": "Er sprecht Deutsch.",
      "correct": "Er spricht Deutsch.",
      "explanation": "For sprechen, er/sie/es uses spricht."
