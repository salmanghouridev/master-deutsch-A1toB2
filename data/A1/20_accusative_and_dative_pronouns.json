{
  "order": 66,
  "topic_number": 66,
  "title": "Accusative and Dative Pronouns",
  "german_title": "Akkusativ- und Dativpronomen",
  "level": "A1",
  "language": "en",
  "definition": "German personal pronouns change depending on their grammatical case. Accusative pronouns commonly represent a direct object; dative pronouns commonly represent an indirect object or are required by certain verbs and prepositions.",
  "rules": [
    {
      "title": "Accusative pronouns",
      "explanation": "Learn these forms for direct objects: mich, dich, ihn, sie, es, uns, euch, sie, Sie.",
      "examples": [
        {
          "german": "Er sieht mich.",
          "english": "He sees me."
        },
        {
          "german": "Ich kenne dich.",
          "english": "I know you."
        },
        {
          "german": "Wir besuchen ihn.",
          "english": "We visit him."
        },
        {
          "german": "Sie hört uns.",
          "english": "She hears us."
        }
      ]
    },
    {
      "title": "Dative pronouns",
      "explanation": "Learn these forms: mir, dir, ihm, ihr, ihm, uns, euch, ihnen, Ihnen.",
      "examples": [
        {
          "german": "Kannst du mir helfen?",
          "english": "Can you help me?"
        },
        {
          "german": "Ich danke dir.",
          "english": "I thank you."
        },
        {
          "german": "Wir geben ihm das Buch.",
          "english": "We give him the book."
        },
        {
          "german": "Das gefällt ihr.",
          "english": "She likes that. / That appeals to her."
        }
      ]
    },
    {
      "title": "Compare direct and indirect objects",
      "explanation": "With verbs such as geben, the person receiving something is often dative and the thing given is accusative.",
      "examples": [
        {
          "german": "Ich gebe dir das Buch.",
          "english": "I give you the book.",
          "note": "dir = dative recipient; das Buch = accusative thing given."
        },
        {
          "german": "Sie zeigt mir den Weg.",
          "english": "She shows me the way."
        },
        {
          "german": "Kannst du uns einen Stift geben?",
          "english": "Can you give us a pen?"
        }
      ]
    },
    {
      "title": "Pronouns with common verbs",
      "explanation": "Helfen takes dative; sehen takes accusative; gefallen commonly uses a dative pronoun for the person who likes something.",
      "examples": [
        {
          "german": "Ich helfe ihm.",
          "english": "I help him."
        },
        {
          "german": "Ich sehe ihn.",
          "english": "I see him."
        },
        {
          "german": "Das gefällt mir.",
          "english": "I like that."
        }
      ]
    }
  ],
