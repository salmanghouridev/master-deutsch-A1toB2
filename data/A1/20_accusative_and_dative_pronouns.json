  "common_mistakes": [
    {
      "wrong": "Kannst du ich helfen?",
      "correct": "Kannst du mir helfen?",
      "explanation": "Helfen takes the dative, so ich becomes mir."
    },
    {
      "wrong": "Ich sehe ihm.",
      "correct": "Ich sehe ihn.",
      "explanation": "Sehen takes the accusative, so er becomes ihn."
    },
    {
      "wrong": "Ich gebe du das Buch.",
      "correct": "Ich gebe dir das Buch.",
      "explanation": "The recipient is dative: du becomes dir."
    }
  ],
