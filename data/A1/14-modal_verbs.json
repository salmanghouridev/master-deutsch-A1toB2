{
  "order": 60,
  "topic_number": 60,
  "title": "Modal Verbs",
  "german_title": "Modalverben",
  "level": "A1",
  "language": "en",
  "definition": "Modal verbs express ability, permission, desire, obligation, or advice. Common A1 modal verbs are können, müssen, wollen, dürfen, sollen, and mögen. The modal verb is conjugated, while the main verb usually stays in the infinitive at the end.",
  "rules": [
    {
      "title": "können — can / be able to",
      "explanation": "Use können for ability or possibility.",
      "examples": [
        {
          "german": "Ich kann schwimmen.",
          "english": "I can swim."
        },
        {
          "german": "Kannst du mir helfen?",
          "english": "Can you help me?"
        }
      ]
    },
    {
      "title": "müssen — must / have to",
      "explanation": "Use müssen for necessity or obligation.",
      "examples": [
        {
          "german": "Ich muss heute arbeiten.",
          "english": "I have to work today."
        },
        {
          "german": "Wir müssen jetzt gehen.",
          "english": "We have to go now."
        }
      ]
    },
    {
      "title": "wollen — want to",
      "explanation": "Use wollen to express a strong intention or want.",
      "examples": [
        {
          "german": "Ich will einen Kaffee trinken.",
          "english": "I want to drink a coffee."
        },
        {
          "german": "Wir wollen nach Hause gehen.",
          "english": "We want to go home."
        }
      ]
    },
    {
      "title": "dürfen — may / be allowed to",
      "explanation": "Use dürfen for permission; nicht dürfen means must not / not be allowed to.",
      "examples": [
        {
          "german": "Darf ich hier sitzen?",
          "english": "May I sit here?"
        },
        {
          "german": "Du darfst hier nicht rauchen.",
          "english": "You are not allowed to smoke here."
        }
      ]
    },
    {
      "title": "sollen — should / be supposed to",
      "explanation": "Use sollen for advice, instructions, or something expected by another person.",
      "examples": [
        {
          "german": "Du sollst mehr Wasser trinken.",
          "english": "You should drink more water."
        },
        {
          "german": "Soll ich dir helfen?",
          "english": "Should I help you?"
        }
      ]
    },
    {
      "title": "mögen / möchte",
      "explanation": "Mögen means to like. Möchte is a polite form used to say what someone would like.",
      "examples": [
        {
          "german": "Ich mag Kaffee.",
          "english": "I like coffee."
        },
        {
          "german": "Ich möchte einen Tee.",
          "english": "I would like a tea."
        },
        {
          "german": "Möchtest du mitkommen?",
          "english": "Would you like to come along?"
        }
      ]
    },
    {
      "title": "Word order with modal verbs",
      "explanation": "The modal verb is conjugated in position two in a statement, and the main verb stays in the infinitive at the end. In questions, the modal verb can come first.",
      "examples": [
        {
          "german": "Heute muss ich lange arbeiten.",
          "english": "Today I have to work for a long time."
        },
        {
          "german": "Kannst du Deutsch sprechen?",
          "english": "Can you speak German?"
        }
      ]
    }
  ],
