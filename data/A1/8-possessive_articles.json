  "title": "Possessive Articles",
  "german_title": "Possessivartikel",
  "level": "A1",
  "language": "en",
  "definition": "Possessive articles show who owns or is connected to something. Common forms include mein (my), dein (your, informal singular), sein (his/its), ihr (her/their), unser (our), euer (your, plural), and Ihr (your, formal). In the nominative, endings depend on the noun's gender and number.",
  "rules": [
    {
      "title": "Basic possessive words",
      "explanation": "Choose the possessive stem according to the owner, then add an ending if required by the noun.",
      "examples": [
        {
          "german": "mein Vater",
          "english": "my father"
        },
        {
          "german": "deine Mutter",
          "english": "your mother"
        },
        {
          "german": "sein Kind",
          "english": "his child"
        },
        {
          "german": "ihre Freunde",
          "english": "her friends"
        }
      ]
    },
    {
      "title": "Nominative endings",
      "explanation": "For masculine and neuter singular nouns, the basic form usually has no -e ending: mein Vater, mein Kind. Feminine singular and plural nouns usually take -e: meine Mutter, meine Kinder.",
      "examples": [
        {
          "german": "mein Bruder",
          "english": "my brother — masculine"
        },
        {
          "german": "meine Schwester",
          "english": "my sister — feminine"
        },
        {
          "german": "mein Auto",
          "english": "my car — neuter"
        },
        {
          "german": "meine Bücher",
          "english": "my books — plural"
        }
      ]
    },
    {
      "title": "Forms by owner",
      "explanation": "The stem changes with the owner, but the ending pattern follows the noun in this basic nominative pattern.",
      "examples": [
        {
          "german": "ich → mein / meine",
          "english": "I → my"
        },
        {
          "german": "du → dein / deine",
          "english": "you (informal) → your"
        },
        {
          "german": "er / es → sein / seine",
          "english": "he / it → his / its"
        },
        {
          "german": "sie → ihr / ihre",
          "english": "she → her"
        },
        {
          "german": "wir → unser / unsere",
          "english": "we → our"
        },
        {
          "german": "ihr → euer / eure",
          "english": "you all → your"
        },
        {
          "german": "sie → ihr / ihre",
          "english": "they → their"
        },
        {
          "german": "Sie → Ihr / Ihre",
          "english": "you (formal) → your"
        }
      ]
    },
    {
      "title": "Simple questions and answers",
      "explanation": "Use a possessive article before the noun; the noun does not need an additional definite article.",
      "examples": [
        {
          "german": "Ist das dein Buch?",
          "english": "Is that your book?"
        },
        {
          "german": "Ja, das ist mein Buch.",
          "english": "Yes, that is my book."
        },
        {
          "german": "Wie heißt deine Schwester?",
          "english": "What is your sister's name?"
        },
        {
          "german": "Unsere Wohnung ist klein.",
          "english": "Our apartment is small."
        }
      ]
    },
    {
      "title": "Euer changes to eure before feminine/plural nouns",
      "explanation": "The stem euer commonly loses the second e when an ending is added: eure Mutter, eure Freunde.",
      "examples": [
        {
          "german": "euer Vater",
          "english": "your father (to a group)"
        },
        {
          "german": "eure Mutter",
          "english": "your mother (to a group)"
        },
        {
          "german": "eure Kinder",
          "english": "your children"
        }
      ]
    }
  ],
