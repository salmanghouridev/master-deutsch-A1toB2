  "spelling_rules": [
    {
      "title": "Verbs ending in -d or -t",
      "rule": "Add an extra -e- before some endings to make pronunciation easier.",
      "examples": [
        {
          "infinitive": "arbeiten",
          "german": "du arbeitest; er arbeitet; ihr arbeitet",
          "english": "you work; he/she works; you (plural) work"
        },
        {
          "infinitive": "warten",
          "german": "du wartest; er wartet; ihr wartet",
          "english": "you wait; he/she waits; you (plural) wait"
        }
      ]
    },
    {
      "title": "Verbs ending in -s, -ß, -z, or -x",
      "rule": "The du form usually ends in -t rather than -st because the stem already ends in a sibilant sound.",
      "examples": [
        {
          "infinitive": "heißen",
          "german": "du heißt",
          "english": "you are called"
        },
        {
          "infinitive": "tanzen",
          "german": "du tanzt",
          "english": "you dance"
        }
      ]
    }
  ],
  "usage_rules": [
    {
      "title": "Use the conjugated verb with the subject",
      "rule": "The verb ending changes according to the subject pronoun.",
      "examples": [
        {
          "german": "Ich mache Kaffee.",
          "english": "I make coffee."
        },
        {
          "german": "Du machst Kaffee.",
          "english": "You make coffee."
        },
        {
          "german": "Er macht Kaffee.",
          "english": "He makes coffee."
        }
      ]
    },
    {
      "title": "Word order in a main clause",
      "rule": "In a normal statement, the conjugated verb is usually in the second position.",
      "examples": [
        {
          "german": "Heute lerne ich Deutsch.",
          "english": "Today I am learning German."
        },
        {
          "german": "Am Samstag arbeite ich.",
          "english": "I work on Saturday."
        }
      ]
    }
  ],
