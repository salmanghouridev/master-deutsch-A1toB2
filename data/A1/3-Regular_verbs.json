  "definition": {
    "english": "Regular verbs follow a predictable pattern in the present tense. Remove -en or -n from the infinitive to find the stem, then add the correct ending.",
    "example": {
      "german": "lernen → ich lerne, du lernst, er lernt",
      "english": "to learn → I learn, you learn, he learns"
    }
  },
  "conjugation_rule": {
    "steps": [
      "Start with the infinitive, for example lernen.",
      "Remove -en: lern- is the stem.",
      "Add the ending for the subject pronoun."
    ],
    "endings": [
      {
        "pronoun": "ich",
        "ending": "-e",
        "example": "ich lern-e"
      },
      {
        "pronoun": "du",
        "ending": "-st",
        "example": "du lern-st"
      },
      {
        "pronoun": "er/sie/es",
        "ending": "-t",
        "example": "er lern-t"
      },
      {
        "pronoun": "wir",
        "ending": "-en",
        "example": "wir lern-en"
      },
      {
        "pronoun": "ihr",
        "ending": "-t",
        "example": "ihr lern-t"
      },
      {
        "pronoun": "sie/Sie",
        "ending": "-en",
        "example": "sie lern-en / Sie lern-en"
      }
    ]
  },
