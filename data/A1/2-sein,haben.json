    }
  ],
  "mastery_goal": [
    "Conjugate sein and haben with all personal pronouns.",
    "Choose sein for identity, descriptions, conditions, and location.",
    "Choose haben for possession and expressions such as Hunger and Durst.",
    "Form yes/no questions by placing the conjugated verb first.",
    "Avoid common mistakes involving bin, bist, ist, sind, habe, hast, hat, haben, and habt."
